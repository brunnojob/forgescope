{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ForgeScope",
          "version": "0.2.0",
          "informationUri": "https://github.com/brunnojob/forgescope",
          "rules": [
            {
              "id": "patchscope/workflow-privilege",
              "shortDescription": {
                "text": "Review this workflow privilege boundary"
              }
            },
            {
              "id": "devrescue/python-module",
              "shortDescription": {
                "text": "Python module is unavailable"
              }
            },
            {
              "id": "impact/missing-local-export",
              "shortDescription": {
                "text": "Review an unresolved local import"
              }
            },
            {
              "id": "patchscope/workflow",
              "shortDescription": {
                "text": "GitHub Actions behavior changed"
              }
            },
            {
              "id": "patchscope/dynamic-code",
              "shortDescription": {
                "text": "Dynamic code execution was added"
              }
            },
            {
              "id": "patchscope/test-coverage",
              "shortDescription": {
                "text": "Confirm behavior is covered"
              }
            },
            {
              "id": "reporelief/ci.missing",
              "shortDescription": {
                "text": "Make checks repeatable"
              }
            },
            {
              "id": "reporelief/docs.link:README.md:5:docs/setup.md",
              "shortDescription": {
                "text": "Repair a missing local Markdown target"
              }
            },
            {
              "id": "reporelief/docs.usage",
              "shortDescription": {
                "text": "Document usage"
              }
            },
            {
              "id": "reporelief/license.missing",
              "shortDescription": {
                "text": "Clarify reuse permissions"
              }
            },
            {
              "id": "cifuse/missing-module",
              "shortDescription": {
                "text": "Module could not be resolved"
              }
            },
            {
              "id": "reporelief/tests.mapping",
              "shortDescription": {
                "text": "Review modules without matching test names"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "patchscope/workflow-privilege",
          "level": "error",
          "message": {
            "text": "Review this workflow privilege boundary\nAn added line uses broad write permissions or pull_request_target.\nNext: Use the minimum token permissions and keep untrusted code away from privileged execution."
          },
          "partialFingerprints": {
            "forgescope/v1": "7479ebc86d10d22b33dd"
          },
          "properties": {
            "engine": "patchscope",
            "correlation": {
              "relation": "same file in import impact set",
              "distance": 0
            }
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "devrescue/python-module",
          "level": "warning",
          "message": {
            "text": "Python module is unavailable\nModuleNotFoundError: No module named 'shop'\nNext: python -m pip --version; Activate the project virtual environment, then install its declared requirements."
          },
          "partialFingerprints": {
            "forgescope/v1": "3da36e6e7f1358dc002c"
          },
          "properties": {
            "engine": "devrescue",
            "correlation": {
              "relation": "same file in import impact set",
              "distance": 1
            }
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/shop/orders.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "impact/missing-local-export",
          "level": "warning",
          "message": {
            "text": "Review an unresolved local import\nshop.pricing.total_v1 -> src/shop/pricing.py: Imported name is absent from the local module binding inventory.\nNext: Check spelling, removed/renamed definitions, re-exports and runtime module initialization. This is a static review lead, not a proven ImportError."
          },
          "partialFingerprints": {
            "forgescope/v1": "73e6edcc7316c225f9ad"
          },
          "properties": {
            "engine": "impact",
            "correlation": {
              "relation": "same file in import impact set",
              "distance": 1
            }
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/shop/legacy.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "patchscope/workflow",
          "level": "warning",
          "message": {
            "text": "GitHub Actions behavior changed\nWorkflow changes can alter what executes and which credentials it receives.\nNext: Review triggers, permissions, action pinning and handling of untrusted pull requests."
          },
          "partialFingerprints": {
            "forgescope/v1": "9415fe48281531c062ca"
          },
          "properties": {
            "engine": "patchscope",
            "correlation": {
              "relation": "same file in import impact set",
              "distance": 0
            }
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ]
        },
        {
          "ruleId": "patchscope/dynamic-code",
          "level": "warning",
          "message": {
            "text": "Dynamic code execution was added\nThe added line calls eval or exec; context determines whether it is unsafe.\nNext: Trace input provenance and prefer a parser or structured operation where possible."
          },
          "partialFingerprints": {
            "forgescope/v1": "cbcbc24b4bf503059d6e"
          },
          "properties": {
            "engine": "patchscope",
            "correlation": {
              "relation": "same file in import impact set",
              "distance": 0
            }
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/shop/pricing.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ]
        },
        {
          "ruleId": "patchscope/test-coverage",
          "level": "note",
          "message": {
            "text": "Confirm behavior is covered\nSource code changed, but this patch contains no changed test files. Existing tests may already cover it.\nNext: Run the relevant suite and add a regression test when behavior changes."
          },
          "partialFingerprints": {
            "forgescope/v1": "3c772722671247e07e1f"
          },
          "properties": {
            "engine": "patchscope",
            "correlation": {
              "relation": "same file in import impact set",
              "distance": 0
            }
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/shop/pricing.py",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ]
        },
        {
          "ruleId": "reporelief/ci.missing",
          "level": "error",
          "message": {
            "text": "Make checks repeatable\nNo GitHub Actions workflow found\nNext: Add CI that runs the actual project checks on pushes and pull requests."
          },
          "partialFingerprints": {
            "forgescope/v1": "6ecdb79e0b5408217a49"
          },
          "properties": {
            "engine": "reporelief",
            "correlation": null
          }
        },
        {
          "ruleId": "reporelief/docs.link:README.md:5:docs/setup.md",
          "level": "warning",
          "message": {
            "text": "Repair a missing local Markdown target\nREADME.md:5: docs/setup.md -> docs/setup.md\nNext: Restore the target or update the link relative to the source file directory. Only local path existence is checked."
          },
          "partialFingerprints": {
            "forgescope/v1": "0d0081c72f0919a96da8"
          },
          "properties": {
            "engine": "reporelief",
            "correlation": null
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "README.md",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ]
        },
        {
          "ruleId": "reporelief/docs.usage",
          "level": "warning",
          "message": {
            "text": "Document usage\nREADME.md\nNext: Add a usage section with commands verified by a maintainer."
          },
          "partialFingerprints": {
            "forgescope/v1": "412c93e3f91a284f2b1a"
          },
          "properties": {
            "engine": "reporelief",
            "correlation": null
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "README.md",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ]
        },
        {
          "ruleId": "reporelief/license.missing",
          "level": "warning",
          "message": {
            "text": "Clarify reuse permissions\nNo root license file found\nNext: Choose and add a license appropriate to the project."
          },
          "partialFingerprints": {
            "forgescope/v1": "5095bfd0d160d388a98f"
          },
          "properties": {
            "engine": "reporelief",
            "correlation": null
          }
        },
        {
          "ruleId": "cifuse/missing-module",
          "level": "warning",
          "message": {
            "text": "Module could not be resolved\nModuleNotFoundError: No module named 'shop'\nNext: Check the module name, declared dependencies, workspace install step and case-sensitive paths. Confirm the import exists on a clean checkout."
          },
          "partialFingerprints": {
            "forgescope/v1": "697874f22dc7d03540b2"
          },
          "properties": {
            "engine": "cifuse",
            "correlation": null
          }
        },
        {
          "ruleId": "reporelief/tests.mapping",
          "level": "warning",
          "message": {
            "text": "Review modules without matching test names\nsrc/shop/__init__.py; src/shop/api.py; src/shop/legacy.py; src/shop/orders.py; src/shop/pricing.py\nNext: Check existing integration coverage first; add behavior tests for uncovered boundaries and failure paths. Filename and directory matching is a heuristic, not coverage."
          },
          "partialFingerprints": {
            "forgescope/v1": "a98086336759b9337629"
          },
          "properties": {
            "engine": "reporelief",
            "correlation": null
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/shop/__init__.py",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}